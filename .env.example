# Copy to .env and fill in. Everything is optional: with nothing set, Headcount runs fully simulated.

# --- Gemini (understands speech; never decides who gets help)
GEMINI_API_KEY=
# If this model name errors, use the current Flash model listed in AI Studio.
GEMINI_MODEL=gemini-3.8-flash
# Seconds to wait for Gemini before falling back to keywords (Twilio waits ~15s for a webhook reply).
HEADCOUNT_GEMINI_TIMEOUT=6

# --- Twilio (real calls + family texts). Trial accounts can only reach Verified Caller IDs.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# A voice-capable Twilio number, E.164 format.
TWILIO_FROM_NUMBER=+1
# Your tunnel URL, EXACTLY, https, no trailing slash (e.g. from `cloudflared tunnel --url http://localhost:8000`).
# It changes every tunnel restart: update it here and restart uvicorn.
PUBLIC_BASE_URL=https://your-tunnel.trycloudflare.com
# 1 = reject webhooks without a valid X-Twilio-Signature. Set 0 if the tunnel URL keeps causing 403s.
TWILIO_VALIDATE=1
# 1 = text family contacts for real (only residents with a contact_phone). 0 = log them as simulated.
HEADCOUNT_SEND_SMS=1
# Maps resident ids to real phones (gitignored). Residents not in it are simulated.
HEADCOUNT_PHONES=residents_phones.json

# --- Campaign timing
# Seconds between first dials.
HEADCOUNT_STAGGER=2
# Seconds a call rings before it counts as no answer.
HEADCOUNT_RING_TIMEOUT=20
# Seconds before calling a missed resident again.
HEADCOUNT_RETRY_GAP=15
# Calls before a WELFARE_CHECK (a person goes to the door).
HEADCOUNT_MAX_ATTEMPTS=3
# 1 = simulated residents answer on their own from the seed scripts.
HEADCOUNT_AUTOPILOT=1
